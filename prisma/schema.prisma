// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type ProductDetails {
  price              Float
  minHeadCount       Int
  maxHeadCount       Int
  scheduleStart      String
  scheduleEnd        String
  scheduleEndNextDay Boolean
  withRooms          Boolean
  description        String?
}

type AddOnDetails {
  description String
  price       Float
}

type Receipt {
  productPrice         Float
  roomPrice            Float
  additionalHeadsPrice Float
  total                Float
}

enum AddOnType {
  ROOM
  PERSON
}

model Product {
  productId     String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  activeVersion Int?             @default(1)
  details       ProductDetails[]
  Booking       Booking[]
}

model AddOn {
  addOnId       String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          AddOnType
  activeVersion Int?           @default(1)
  details       AddOnDetails[]
  Booking       Booking[]
}

model Booking {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String
  phoneNumber    String
  startSession   DateTime
  endSession     DateTime
  guests         Int
  room           AddOn    @relation(fields: [AddOnId], references: [addOnId])
  AddOnId        String   @db.ObjectId
  AddOnVersion   Int
  product        Product  @relation(fields: [productId], references: [productId])
  productId      String   @db.ObjectId
  productVersion Int
  receipt        Receipt
}
