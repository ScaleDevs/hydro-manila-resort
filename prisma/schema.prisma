// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type UpdateLog {
  updatedBy    String
  fieldUpdated String
  fromValue    String
  toValue      String
  createdAt    DateTime @default(now())
}

type RoomDetails {
  description  String?
  withBathroom Boolean
  guests       Int
  price        Float
}

type Receipt {
  productPrice         Float
  roomPrice            Float
  additionalHeadsPrice Float
  bookingFee           Int
  total                Float
}

type BookingUpdateLog {
  transactionRefNo String?
  updatedBy        String
  fieldUpdated     String
  fromValue        String
  toValue          String
  createdAt        DateTime @default(now())
}

enum TransactionType {
  REFUND
  PAYMENT
}

enum ProcessType {
  BANK
  PAYMONGO
  CASH
}

type TransactionLog {
  refNo           String?
  paymentIntentId String?
  process         ProcessType     @default(PAYMONGO)
  type            TransactionType
  amount          Int
  addedBy         String?         @default("SYSTEM")
  createdAt       DateTime?
}

type Guests {
  nonOverNightGuests Int
  overNightGuests    Int
}

type GuestSettings {
  overNightGuestFee       Int
  minNonOverNightGuestPax Int
  maxNonOverNightGuestPax Int
  nonOverNightGuestFee    Int
  minOverNightGuestPax    Int
  maxOverNightGuestPax    Int
}

enum BookingRefundStatus {
  FAILED
  PROCESSING
  SUCCESS
}

enum BookingRefundType {
  AUTOMATIC
  MANUAL
}

model Product {
  productId          String        @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  price              Float
  scheduleStart      String
  scheduleEnd        String
  scheduleEndNextDay Boolean
  includedRooms      String[]
  isAllRooms         Boolean
  guestSetting       GuestSettings
  description        String?
  updateLogs         UpdateLog[]
}

model Room {
  roomId           String      @id @default(auto()) @map("_id") @db.ObjectId
  roomIdentityName String
  description      String?
  guests           Int
  price            Float
  withBathroom     Boolean
  withAircon       Boolean
  withFan          Boolean
  bedSingle        Int
  bedDouble        Int
  bedQueen         Int
  updateLogs       UpdateLog[]
}

model Booking {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  ref_no          String             @unique
  name            String
  email           String
  phoneNumber     String
  startSession    DateTime
  endSession      DateTime
  guests          Guests
  rooms           String[]
  productId       String             @db.ObjectId
  receipt         Receipt
  updateLogs      BookingUpdateLog[]
  transactionLogs TransactionLog[]
  paymentIntentId String             @unique
  paymentId       String
  refundId        String?
  calendarEventId String?
  hostawayId      Int?
  createdAt       DateTime           @default(now())

  @@index([startSession, endSession])
}

model BookingSetting {
  bookingSettingId String    @id @default(auto()) @map("_id") @db.ObjectId
  bookingFee       Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime? @updatedAt
}

model BookingRefund {
  bookingRefundId  String              @id @default(auto()) @map("_id") @db.ObjectId
  type             BookingRefundType
  process          ProcessType?
  status           BookingRefundStatus
  referenceNo      String?
  paymongoRefundId String?
  amount           Float?
  reason           String
  updatedBy        String?
  createdAt        DateTime            @default(now())
}

model ScheduledEvent {
  scheduledEventId String   @id @default(auto()) @map("_id") @db.ObjectId
  guestName        String
  guests           Int
  startSession     DateTime
  endSession       DateTime
  description      String
  calendarEventId  String?
  createdAt        DateTime @default(now())
  hostawayId       Int?
  createdBy        String?
}

model BookingAttempt {
  bookingAttemptId String   @id @default(auto()) @map("_id") @db.ObjectId
  startSession     DateTime
  endSession       DateTime
  ref_no           String   @unique
  createdAt        DateTime @default(now())
  expireAt         DateTime
}

model Secrets {
  secretId        String   @id @default(auto()) @map("_id") @db.ObjectId
  secretsIdentity String
  clientId        String
  clientSecret    String
  accessToken     String
  expiresIn       Int
  isActive        Boolean
  createdAt       DateTime
}
