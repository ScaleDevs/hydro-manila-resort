// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type ProductDetails {
  price              Float
  scheduleStart      String
  scheduleEnd        String
  scheduleEndNextDay Boolean
  withRooms          Boolean
  description        String?
}

type RoomDetails {
  description  String?
  withBathroom Boolean
  guests       Int
  price        Float
}

type Receipt {
  productPrice         Float
  roomPrice            Float
  additionalHeadsPrice Float
  total                Float
}

model Product {
  productId     String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  activeVersion Int              @default(1)
  details       ProductDetails[]
  Booking       Booking[]
}

model Room {
  roomId        String        @id @default(auto()) @map("_id") @db.ObjectId
  roomNumber    Int
  activeVersion Int           @default(1)
  details       RoomDetails[]
  Booking       Booking[]
}

model Booking {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  ref_no          String   @unique
  name            String
  email           String
  phoneNumber     String
  startSession    DateTime
  endSession      DateTime
  guests          Int
  room            Room     @relation(fields: [roomId], references: [roomId])
  roomId          String   @db.ObjectId
  roomVersion     Int
  product         Product  @relation(fields: [productId], references: [productId])
  productId       String   @db.ObjectId
  productVersion  Int
  receipt         Receipt
  paymentIntentId String   @unique
  paymentId       String
  refundId        String?
  createdAt       DateTime @default(now())
}

model BookingSetting {
  bookingSettingId String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingFee       Int
  minPax           Int
  maxPax           Int
  createdAt        DateTime @default(now())
}
